# Lumen production configuration
LLM_MODEL_PATH=/opt/lumen/models/model.gguf
LUMEN_CONTEXT_SIZE=8192
LUMEN_GPU_LAYERS=0
LUMEN_THREADS=0
LUMEN_MAX_TOKENS=1024
LUMEN_BIND=127.0.0.1
LUMEN_PORT=8080
LUMEN_API_KEY=replace-with-a-long-random-key
LUMEN_RATE_LIMIT_PER_MIN=120
LUMEN_MAX_CLIENTS=128
LUMEN_SOCKET_TIMEOUT_SEC=15
BRAVE_API_KEY=
RAG_INDEX_PATH=/opt/lumen/data/rag_index.bin
LUMEN_TEMPERATURE=0.7
LUMEN_TRUST_PROXY=0
